<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block access to .env and hidden files
    RewriteRule ^\.env - [F,L,NC]
    RewriteRule (^|/)\.(?!well-known) - [F]

    # Rewrite all requests to the public/ folder
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
